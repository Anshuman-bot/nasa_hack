# ============================================================
# TerraScan Backend Environment Variables — Prompt 5
# ============================================================
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# ----------------------------------------------------------
# NASA Earthdata Login
# Required for DOWNLOADING data via NASA Earthdata / ASF.
# Search (metadata discovery) is unauthenticated — no credentials needed.
# Register at: https://urs.earthdata.nasa.gov/users/new
# ----------------------------------------------------------
EARTHDATA_USERNAME=your_earthdata_username_here
EARTHDATA_PASSWORD=your_earthdata_password_here

# ----------------------------------------------------------
# ASF Download Token (optional — alternative to username/password)
# Generate at: https://urs.earthdata.nasa.gov/profile
# If set, used instead of EARTHDATA_USERNAME/PASSWORD for ASF downloads.
# ----------------------------------------------------------
# ASF_TOKEN=your_asf_token_here

# ----------------------------------------------------------
# CSA (Canadian Space Agency) — RADARSAT Data
# Required for data ordering via CSA Open Data portal.
# No API key needed for CKAN catalogue metadata discovery.
# ----------------------------------------------------------
# CSA_API_KEY=not_currently_required

# ----------------------------------------------------------
# CONAE (Argentina) — SAOCOM Data
# CONAE does not provide a public REST API.
# Data requests must be submitted through the web portal.
# ----------------------------------------------------------
# CONAE_USERNAME=your_conae_account_here

# ----------------------------------------------------------
# Backend server settings
# ----------------------------------------------------------
PORT=8000
HOST=0.0.0.0
